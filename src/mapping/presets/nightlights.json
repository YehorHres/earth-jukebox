{
  "id": "nightlights",
  "title": "Нічна карта вогнів",
  "tempo": { "feature": "lightPoints", "channel": "abs", "agg": "videoMean", "in": [0.0, 0.5], "bpm": [62, 92],
             "why": "Більше вогнів на карті — трохи швидший темп; темні карти звучать повільно" },
  "params": {
    "energy": { "base": 0.1, "sources": [
        { "feature": "lightLog", "channel": "rel", "weight": 0.25, "curve": "smooth" },
        { "feature": "lightPoints", "channel": "rel", "weight": 0.3, "curve": "smooth" },
        { "feature": "hotspot1", "channel": "rel", "weight": 0.25, "curve": "smooth" }
      ], "why": "Що більше світла (у лог-шкалі), то гучніше й тим більше інструментів" },
    "density": { "base": 0.1, "sources": [
        { "feature": "lightPoints", "channel": "rel", "weight": 0.4, "curve": "linear" },
        { "feature": "lightClusters", "channel": "rel", "weight": 0.3, "curve": "linear" },
        { "feature": "hotspot1", "channel": "speed10", "weight": 0.2, "curve": "log" }
      ], "why": "Кількість світлових точок і кластерів — густота «зоряного дощу» коротких нот" },
    "tension": { "base": 0.1, "sources": [
        { "feature": "hotspot1", "channel": "trend40", "weight": 0.35, "curve": "linear" },
        { "feature": "agglomeration", "channel": "rel", "weight": 0.25, "curve": "exp" },
        { "feature": "lightPoints", "channel": "rank", "weight": 0.2, "curve": "exp" }
      ], "why": "Місто, що росте (тренд світла), і щільні агломерації — більше напруги в гармонії" },
    "brightness": { "base": 0.0, "sources": [
        { "feature": "darkShare", "channel": "abs", "in": [0.6, 1.0], "weight": 0.7, "curve": "linear", "invert": true },
        { "feature": "lightLog", "channel": "rel", "weight": 0.3, "curve": "linear" }
      ], "why": "Темний кадр — темний лад; більше світла — світліший" },
    "register": { "base": 0.15, "sources": [
        { "feature": "centerY", "channel": "abs", "in": [0.3, 0.7], "weight": 0.5, "curve": "linear" },
        { "feature": "lightLog", "channel": "rel", "weight": 0.3, "curve": "linear" }
      ], "why": "Вогні на півночі — вищий регістр" },
    "pan": { "base": 0.0, "range": [-1, 1], "sources": [
        { "feature": "balanceLR", "channel": "abs", "in": [-0.5, 0.5], "weight": 1.0, "curve": "linear" }
      ], "why": "Захід — ліворуч, схід — праворуч" },
    "motion": { "base": 0.05, "sources": [
        { "feature": "hotspot1", "channel": "speed10", "weight": 0.5, "curve": "linear" },
        { "feature": "lightPoints", "channel": "speed10", "weight": 0.4, "curve": "linear" }
      ], "why": "Швидкість змін світла — рухливість партій" },
    "articulation": { "base": 0.5, "sources": [
        { "feature": "lightPoints", "channel": "rel", "weight": 0.3, "curve": "linear" }
      ], "why": "Вогні — короткі дзвінкі ноти (стакато), більше вогнів — коротші" },
    "space": { "base": 0.45, "sources": [
        { "feature": "darkShare", "channel": "abs", "in": [0.6, 1.0], "weight": 0.5, "curve": "linear" }
      ], "why": "Темрява — глибокий дрон із довгою луною" }
  },
  "contour": { "zone": "cols", "channel": "rel", "why": "Мелодія сканує кадр зліва направо: вище нота — більше світла в цій смузі; темрява — пауза" },
  "accent": { "events": ["peak", "thresholdCross", "changePoint", "globalMax", "returnOfState"], "why": "Спалахи й зміни — челеста та дзвіночки" }
}
